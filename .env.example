# ===== GameVox Bot Configuration (Discord API v10 compatible) =====
GAMEVOX_BOT_TOKEN=replace_with_your_gamevox_bot_token
GAMEVOX_API_BASE=https://app-api.gamevox.com/api/v10
GAMEVOX_GATEWAY_URL=wss://gateway.gamevox.com/?v=10&encoding=json
# Optional default server & channel for auto-posting (can also be set via `wws channel`)
DEFAULT_GUILD_ID=
DEFAULT_AUTO_POST_CHANNEL_ID=
# Optional comma-separated GameVox user IDs allowed to run admin commands (channel / lang server / track @other)
ADMIN_USER_IDS=

# ===== Wargaming Developer API (NA / EU / ASIA) =====
# Register a free Server app at https://developers.wargaming.net/
WG_APPLICATION_ID=replace_with_your_wg_application_id

# ===== Bot Behavior =====
COMMAND_PREFIX=wws
DEFAULT_LANGUAGE=zh
# Supported realms: na, eu, asia
DEFAULT_REALM=na

# ===== Storage & Queue (SQLite WAL + Honker) =====
DATA_DIR=/data
DB_PATH=/data/wows_bot.db
HONKER_WATCH_INTERVAL_MS=25

# ===== Polling & Squad Coalescing =====
POLL_INTERVAL_SECONDS=60
SQUAD_RECHECK_DELAY_SECONDS=12
SQUAD_FINALIZE_DELAY_SECONDS=40
SQUAD_TIME_TOLERANCE_SECONDS=20

# ===== Playwright Rendering =====
RENDER_CONCURRENCY=2
RENDER_IMAGE_FORMAT=png
RENDER_TIMEOUT_SECONDS=30

# ===== Optional Public Data Sources (zero auth required) =====
ENABLE_YUYUKO_SHIP_RANK=true
YUYUKO_API_BASE=https://v3-api.wows.shinoaki.com
WOWS_NUMBERS_PR_URL=https://api.wows-numbers.com/personal/rating/expected/json/
LOG_LEVEL=INFO
